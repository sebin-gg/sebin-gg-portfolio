{
  "name": "sebin-gg-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --coverage",
    "test:unit:fast": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:local": "playwright test --project=chromium --project=firefox --project=mobile",
    "test:mutation": "stryker run",
    "test:all": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:unit && pnpm test:e2e",
    "crap:gate": "node scripts/crap-gate.mjs",
    "perf:audit": "lhci autorun",
    "perf:matrix": "node scripts/perf-lighthouse-matrix.mjs",
    "perf:quick": "node scripts/perf-lighthouse-matrix.mjs --devices mobile,desktop --themes dark --networks 4G --cpus laptop,phone/mid-tier --modes navigation --routes /,/blog",
    "test:perf": "node scripts/perf-matrix-test.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "check:thorium": "node scripts/thorium-check.mjs",
    "check:browsers": "node scripts/browsers-check.mjs",
    "check:safari": "node scripts/safari-check.mjs",
    "check:firefox": "node scripts/firefox-check.mjs",
    "check:terminal": "node scripts/terminal-check.mjs",
    "check:all": "bash scripts/check-all.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0",
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 16",
    "ios_saf >= 16",
    "opera >= 95",
    "samsung >= 22"
  ]
}
