# Network note (Sep 2026): registry.npmjs.org was timing out from this machine.
# If that happens again, uncomment the mirror line and reinstall from scratch:
#   rm -rf node_modules pnpm-lock.yaml && pnpm install
# registry=https://registry.npmmirror.com

fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=30000
network-timeout=60000
